# PostgreSQL
POSTGRES_DB=codexam
POSTGRES_USER=codexam_user
POSTGRES_PASSWORD=change-me

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT
JWT_SECRET=change-this-secret-minimum-32-characters
JWT_ISSUER=CodExam
JWT_AUDIENCE=CodExamUsers

# API
API_PORT=5000
ASPNETCORE_ENVIRONMENT=Development

# Frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost/api

# Runner Limits
RUNNER_CPU_LIMIT=0.5
RUNNER_MEMORY_LIMIT=256m
RUNNER_TIMEOUT_SECONDS=10