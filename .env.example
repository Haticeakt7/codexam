# PostgreSQL
POSTGRES_DB=codexam
POSTGRES_USER=codexam_user
POSTGRES_PASSWORD=change-me

# Redis
REDIS_PASSWORD=change-me-redis

# JWT
JWT_SECRET=change-this-secret-minimum-32-characters!!
JWT_EXPIRES_MINUTES=15
JWT_REFRESH_DAYS=7

# ASP.NET Core
ASPNETCORE_ENVIRONMENT=Development

# Runner limits (optional — docker-compose has these defaults)
RUNNER_CPU_QUOTA=0.5
RUNNER_MEMORY_MB=256
RUNNER_PYTHON_TIMEOUT_SEC=10
RUNNER_NODE_TIMEOUT_SEC=10
RUNNER_CPP_TIMEOUT_SEC=15
